# ---------------------------------------------------------------------------
# Cypress Scheduler — environment template. Copy to `.env` and fill in values.
# (.env is gitignored.) See CLAUDE.md §4 for details.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) -----------------------------------------
# Runtime connection: SHARED TRANSACTION-mode pooler (port 6543, pgbouncer).
# The app (lib/db.ts) uses this. Keep `?pgbouncer=true` so Prisma disables
# prepared statements over the pooler.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations / seeding: SESSION-mode pooler (port 5432). Used by
# `prisma db push`, `prisma migrate`, and seed.ts. DDL must NOT go over the
# transaction pooler. Falls back to DATABASE_URL if unset.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-us-east-2.pooler.supabase.com:5432/postgres"

# Optional TLS override (auto-selected by host if omitted): "true" | "false"
# DB_SSL_REJECT_UNAUTHORIZED=false

# --- Auth (NextAuth + Google OAuth) ---------------------------------------
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_long_random_string

# --- AI chat (optional; falls back to local guidance if unset) ------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Email notifications (optional) ---------------------------------------
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=noreply@yourdomain.com
